#!/usr/bin/env python3
"""Start Claude Code with one method on, or print the method list.

The one reader of the method list and of each method's plugin set. A method
is an entry of the marketplace's .claude-plugin/marketplace.json whose
category is "method"; its key is <name>@<marketplace name>. Its plugin set is
the dependencies field of its own .claude-plugin/plugin.json.

The marketplace folder is $CLAUDE_METHOD_MARKETPLACE when set, else the
installLocation of entry claude-setup in
$HOME/.claude/plugins/known_marketplaces.json.

Usage:

- claude-method: one line per method, <name><TAB><description>, then none.
- claude-method --json <m>: the settings JSON for method <m>, or none.
- claude-method --methods: one JSON object, each method key to its list of
  dependency keys.
- claude-method <m> [<claude args>...]: runs claude --settings <json> with
  the args. A --plugin-dir that names a method's folder turns that method's
  marketplace key off, so its folder copy loads alone. A --settings in the
  args is refused with exit 2.

The settings JSON turns the chosen method and its dependencies on, and the
off set off: every other method and dependency key, minus the chosen ones.
An unknown method lists the methods on stderr and exits 1. An unreadable
file, or no claude-setup entry, prints the file and the reason, exit 1.
"""

import json
import os
import sys
from pathlib import Path

ENTRY = "claude-setup"
NONE = "none"
NONE_LINE = f"{NONE}\tNo method: every method and its plugins off"


class Failure(Exception):
    """A file that cannot be read, with the reason."""


def read_json(path):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError) as err:
        raise Failure(f"{path}: {err}") from err


def marketplace_folder():
    env = os.environ.get("CLAUDE_METHOD_MARKETPLACE")
    if env:
        return Path(env)
    known = Path(os.environ.get("HOME") or Path.home()) / ".claude" / "plugins" \
        / "known_marketplaces.json"
    data = read_json(known)
    entry = data.get(ENTRY) if isinstance(data, dict) else None
    location = entry.get("installLocation") if isinstance(entry, dict) else None
    if not isinstance(location, str):
        raise Failure(f"{known}: no {ENTRY} entry with an installLocation")
    return Path(location)


def dependency_key(dep, market):
    if isinstance(dep, dict):
        return f"{dep['name']}@{dep.get('marketplace', market)}"
    return dep if "@" in dep else f"{dep}@{market}"


def load_methods():
    """Return (marketplace name, [(name, key, description, [dependency keys])])."""
    folder = marketplace_folder()
    path = folder / ".claude-plugin" / "marketplace.json"
    data = read_json(path)
    if not isinstance(data, dict) or not isinstance(data.get("plugins"), list):
        raise Failure(f"{path}: no plugins list")
    market = data.get("name", ENTRY)
    methods = []
    for entry in data["plugins"]:
        if not isinstance(entry, dict) or entry.get("category") != "method":
            continue
        manifest_path = folder / entry["source"] / ".claude-plugin" / "plugin.json"
        manifest = read_json(manifest_path)
        try:
            deps = [dependency_key(d, market) for d in manifest.get("dependencies", [])]
        except (AttributeError, KeyError, TypeError) as err:
            raise Failure(f"{manifest_path}: bad dependencies: {err}") from err
        methods.append((entry["name"], f"{entry['name']}@{market}",
                        entry.get("description", ""), deps))
    return market, methods


def listing(methods):
    return "\n".join([f"{name}\t{desc}" for name, _, desc, _ in methods] + [NONE_LINE])


def settings(name, methods):
    every = {}
    for _, key, _, deps in methods:
        every[key] = False
        for dep in deps:
            every[dep] = False
    for method, key, _, deps in methods:
        if method == name:
            for on in [key, *deps]:
                every[on] = True
    return {"enabledPlugins": every}


def plugin_dirs(args):
    for i, arg in enumerate(args):
        if arg == "--plugin-dir" and i + 1 < len(args):
            yield args[i + 1]
        elif arg.startswith("--plugin-dir="):
            yield arg.split("=", 1)[1]


def folder_plugin_name(folder):
    try:
        data = json.loads((Path(folder).resolve() / ".claude-plugin" / "plugin.json")
                          .read_text())
    except (OSError, ValueError):
        return None
    return data.get("name") if isinstance(data, dict) else None


def main(argv):
    if argv and argv[0] not in ("--json", "--methods"):
        if any(a == "--settings" or a.startswith("--settings=") for a in argv[1:]):
            print("claude-method: --settings is not allowed; claude-method passes its own",
                  file=sys.stderr)
            return 2
    try:
        market, methods = load_methods()
    except Failure as err:
        print(f"claude-method: {err}", file=sys.stderr)
        return 1
    names = [name for name, _, _, _ in methods] + [NONE]
    if not argv:
        print(listing(methods))
        return 0
    if argv[0] == "--methods":
        print(json.dumps({key: deps for _, key, _, deps in methods}, sort_keys=True))
        return 0
    json_mode = argv[0] == "--json"
    name = argv[1] if json_mode and len(argv) > 1 else (None if json_mode else argv[0])
    if name not in names:
        print(f"claude-method: no method named {name}", file=sys.stderr)
        print(listing(methods), file=sys.stderr)
        return 1
    chosen = settings(name, methods)
    if json_mode:
        print(json.dumps(chosen, sort_keys=True))
        return 0
    args = argv[1:]
    method_names = {method for method, _, _, _ in methods}
    for folder in plugin_dirs(args):
        plugin = folder_plugin_name(folder)
        if plugin in method_names:
            chosen["enabledPlugins"][f"{plugin}@{market}"] = False
    try:
        os.execvp("claude", ["claude", "--settings", json.dumps(chosen, sort_keys=True),
                             *args])
    except OSError as err:
        print(f"claude-method: claude: {err}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
