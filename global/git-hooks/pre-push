#!/bin/sh
# Rules in ~/.claude/rules/docs-layout.md, "One feature, four commits on main": doc edits are fixups squashed before each push, and a doc
# cites only commits that are part of the pushed history.
zero=0000000000000000000000000000000000000000
fail=0
while read local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then range="$local_sha"; else range="$remote_sha..$local_sha"; fi
  bad=$(git log --format='%h %s' "$range" --not --remotes | grep -E '^[0-9a-f]+ (fixup|squash|amend)! ')
  if [ -n "$bad" ]; then
    echo "pre-push: unsquashed fixup commits, run git-fold-fixups.py (step 9):" >&2
    echo "$bad" >&2
    fail=1
  fi
  stale=$(git grep -hoE '`[^`]+`' "$local_sha" -- docs | grep -oE '\b[0-9a-f]{7,40}\b' | sort -u |
    while read h; do
      git cat-file -e "$h^{commit}" 2>/dev/null || continue
      git merge-base --is-ancestor "$h" "$local_sha" || echo "$h"
    done)
  if [ -n "$stale" ]; then
    echo "pre-push: docs cite commits outside the pushed history (rebased away, or on a local branch):" >&2
    for h in $stale; do git grep -n "$h" "$local_sha" -- docs >&2; done
    fail=1
  fi
done
exit $fail
